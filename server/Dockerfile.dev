FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Install nodemon for hot reload
RUN npm install -g nodemon

# Copy server code
COPY . .

# Create data directory
RUN mkdir -p /app/data

EXPOSE 3001

# Start with nodemon for hot reload
CMD ["nodemon", "--watch", ".", "--ext", "js,json", "index.js"]
