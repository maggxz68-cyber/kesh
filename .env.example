# ===== Database =====
DATABASE_URL=postgresql+asyncpg://ffuser:CHANGE_ME@localhost:5432/family_finance
POSTGRES_DB=family_finance
POSTGRES_USER=ffuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===== Auth / JWT =====
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ===== Superadmin (seed) =====
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=1968
# Требовать смену пароля супер-админа при первом входе (для тестирования можно false)
SUPERADMIN_FORCE_PASSWORD_CHANGE=false

# ===== App =====
APP_ENV=production            # development | production
TZ=Europe/Moscow
DOMAIN=family-finance.example.com
DEMO_MODE=true                # разрешить demo-login и sandbox-копии
SANDBOX_TTL_HOURS=24          # автоудаление песочниц гостей
DEMO_RESET_ENABLED=true       # ежедневный сброс общей демо-семьи (cron)
CORS_ORIGINS=http://localhost:5173

# ===== Files =====
RECEIPTS_DIR=/data/receipts
MAX_UPLOAD_MB=10

# ===== Rate limit =====
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_DEMO=5/minute
RATE_LIMIT_UPLOAD=20/minute

# ===== SMTP (восстановление пароля; без него ссылка пишется в лог) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=true

# ===== ФНС (проверка чеков по QR; MVP может работать без ключа) =====
FNS_CHECK_API_URL=https://prochecksum.gov.ru/checkstatus
FNS_CHECK_API_KEY=

# ===== Frontend build args =====
VITE_API_BASE=/api

# ===== Tags for compose images =====
TAG=latest
