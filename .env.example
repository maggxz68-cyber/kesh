# ===========================================
# Конфигурация приложения "Семейный бюджет"
# ===========================================

# Порт приложения (по умолчанию 3001)
APP_PORT=3001

# Секретный ключ для JWT токенов
# ВАЖНО: Измените на случайную строку в production!
# Генерация: openssl rand -base64 32
JWT_SECRET=change-this-in-production-use-strong-random-string

# Порт Nginx (если используется профиль with-nginx)
NGINX_PORT=80

# Режим работы (development/production)
NODE_ENV=production
